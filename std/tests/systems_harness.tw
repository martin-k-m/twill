mode systems

# systems_harness.tw: the assertions the systems-mode std tests are written with.
#
# WHY THIS IS NOT harness.tw
#
# `harness.tw` next to it is the numeric-mode harness, and it cannot be used
# from a systems-mode file: it takes untyped parameters, calls `print` and the
# tensor builtins `abs` and `max`, and keeps its counters in file-level mutable
# state. None of those exist or are permitted here. The modules tested through
# this one (linalg, stats, random, json, text, io) are systems mode because they
# need mutation, byte handling and integer arithmetic, so their tests are too,
# and the two harnesses are separate for the same reason the two halves of the
# library are.
#
# The shape of the API is deliberately the same as the numeric one so that the
# two suites read alike, with one difference: the counters are a `Report` passed
# in rather than file-level state. That is not a stylistic preference.
# `docs/needs.md` NEEDS-82 records that a file-level `let` mutated in place is
# not specified to work in the systems subset, and a harness resting on an
# unspecified feature reports its own bugs as the library's.
#
# There is no test runner: no registration, no reflection, no discovery. Each
# test file has a `main` that calls its checks in order and returns 0 or 1. A
# test that is not called is then visibly not called, rather than invisibly not
# discovered.
#
# ON THE EXPECTED VALUES IN THESE FILES
#
# Every numeric expectation carries a comment saying where it came from. There
# are only three legitimate provenances and each test states which:
#
#   - exact by hand, where the answer is a small integer or a fraction that can
#     be checked by reading it (the determinant of a 2-by-2, a Cholesky factor
#     with integer entries),
#   - a closed form (the mean of [2, 4, 4, 4, 5, 5, 7, 9] is 5),
#   - computed with an independent implementation, named in the comment, with
#     the full double written out.
#
# What is not allowed is a number produced by running this library and pasted
# back in. That is not a test, it is a snapshot of current behaviour, and it
# passes just as happily when the behaviour is wrong.

struct Report {
  passed: I64,
  failed: I64,
  failures: Arr[Str],
}

fn new_report() -> Report = Report { passed: 0, failed: 0, failures: arr_new() }

# The description is a sentence, present tense, saying what should be true:
# "solve recovers the known solution of a 3 by 3 system". A failure then reads
# as the negation of a claim rather than as the name of a function, which is
# what makes a failing run diagnosable without opening the file.
fn check(rp: Report, desc: Str, cond: Bool) {
  if cond {
    rp.passed = rp.passed + 1
  } else {
    rp.failed = rp.failed + 1
    push(rp.failures, desc)
  }
}

fn fabs(x: F64) -> F64 = if x < 0.0 { 0.0 - x } else { x }

# Absolute tolerance, and every caller passes one explicitly.
#
# No default tolerance anywhere in these tests. A default is always wrong for
# something: 1e-12 rejects a legitimate result from the erfc approximation,
# which is only good to 1e-7, and 1e-7 accepts a broken LU. Making it an
# argument forces each test to state how accurate it believes the function under
# test to be, which is the useful part of the assertion.
fn close(got: F64, want: F64, tol: F64) -> Bool = fabs(got - want) <= tol

fn check_close(rp: Report, desc: Str, got: F64, want: F64, tol: F64) {
  check(rp, desc, close(got, want, tol))
}

fn check_eq_i64(rp: Report, desc: Str, got: I64, want: I64) {
  check(rp, desc, got == want)
}

fn check_eq_str(rp: Report, desc: Str, got: Str, want: Str) {
  check(rp, desc, got == want)
}

# Print the outcome and give the exit status: 0 when everything passed.
#
# Failures go to stderr and the summary to stdout, so a run in a pipeline shows
# what broke even when the output is redirected. Only the failures are printed,
# not every check: a passing suite that prints six hundred lines trains people
# to stop reading it.
fn report(rp: Report, suite: Str) -> I64 {
  let i: I64 = 0
  while i < len(rp.failures) {
    let b: Bytes = bytes_new()
    push_text(b, "  FAIL  ")
    push_text(b, suite)
    push_text(b, ": ")
    push_text(b, rp.failures[i])
    bytes_push(b, 10)
    write_err(b)
    i = i + 1
  }
  let s: Bytes = bytes_new()
  push_text(s, suite)
  push_text(s, " passed ")
  push_text(s, str(rp.passed))
  push_text(s, " failed ")
  push_text(s, str(rp.failed))
  bytes_push(s, 10)
  if rp.failed > 0 {
    push_text(s, "FAILED")
  } else {
    push_text(s, "OK")
  }
  bytes_push(s, 10)
  write_out(s)
  if rp.failed > 0 { return 1 }
  0
}

fn push_text(b: Bytes, s: Str) {
  let i: I64 = 0
  while i < len(s) {
    bytes_push(b, s[i])
    i = i + 1
  }
}

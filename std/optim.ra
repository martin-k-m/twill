# optim.ra — optimizers that operate on a model held as a list of tensors.
#
# Each step takes the parameter list and the matching gradient list (from
# `grad`) and returns updated parameters. Stateful optimizers also take and
# return their state, so everything stays pure.

# A list of zero tensors shaped like `params` (handy for optimizer state).
fn zeros_like(params) = map(fn(p) = p * 0.0, params)

# Plain stochastic gradient descent.
fn sgd_step(params, grads, lr) =
  map(fn(pg) = pg[0] - pg[1] * lr, zip(params, grads))

# SGD with momentum. Returns [new_params, new_velocity].
fn momentum_step(params, grads, velocity, lr, mu) {
  let steps = map(fn(z) {
    let v2 = mu * z[2] - lr * z[1]
    [z[0] + v2, v2]
  }, zip(params, grads, velocity))
  [map(fn(s) = s[0], steps), map(fn(s) = s[1], steps)]
}

# Adam. `t` is the 1-based step count. Returns [new_params, new_m, new_v].
fn adam_step(params, grads, m, v, t, lr, b1, b2, eps) {
  let bc1 = 1.0 - pow(b1, t)
  let bc2 = 1.0 - pow(b2, t)
  let steps = map(fn(z) {
    let g = z[1]
    let m2 = b1 * z[2] + (1.0 - b1) * g
    let v2 = b2 * z[3] + (1.0 - b2) * g * g
    let mhat = m2 / bc1
    let vhat = v2 / bc2
    let p2 = z[0] - lr * mhat / (sqrt(vhat) + eps)
    [p2, m2, v2]
  }, zip(params, grads, m, v))
  [map(fn(s) = s[0], steps),
   map(fn(s) = s[1], steps),
   map(fn(s) = s[2], steps)]
}

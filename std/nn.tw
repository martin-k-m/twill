# nn.tw — a small neural-network toolkit written in Twill.
#
# Import it with:  import "std/nn"  — the library ships inside the binary, so
# the path is the same from any directory. It pulls in the optimizers from
# std/optim as well. Parameters are held in plain lists, so `grad`
# differentiates a whole model at once and the optimizers update it.

import "std/optim"

# ---- layers --------------------------------------------------------------

# Affine layer: y = W @ x + b.
fn dense(W, b, x) = W @ x + b

# 2-D convolution layer. `layer` is [kernel, bias] where kernel is
# [Cout, Cin, KH, KW] and bias is [Cout, 1, 1]; x is [Cin, H, W]. The bias
# broadcasts across the spatial dimensions of the [Cout, OH, OW] output.
fn conv(layer, x) = conv2d(x, layer[0]) + layer[1]

# Embedding lookup: rows of `table` ([vocab, dim]) selected by integer `ids`.
# Differentiable in the table — grad flows back through gather's scatter-add, so
# the embeddings are learned.
fn embed(table, ids) = gather(table, ids)

# Single-head self-attention over a sequence X ([T, dim]). Wq, Wk, Wv are each
# [dim, dim]; the result is the attended sequence [T, dim]. This is the core
# transformer operation, and `grad` differentiates all the way through it.
fn self_attention(Wq, Wk, Wv, X) {
  let dim = len(X[0])
  let scores = (X @ Wq) @ transpose(X @ Wk) / sqrt(dim)
  softmax(scores, 1) @ (X @ Wv)
}

# ---- activations ---------------------------------------------------------
# relu, tanh, sigmoid, and softmax are builtins; these are a few extras.

fn softplus(x) = log(1.0 + exp(x))

fn leaky_relu(x) = relu(x) - 0.01 * relu(-x)

# Tanh approximation of GELU.
fn gelu(x) = 0.5 * x * (1.0 + tanh(0.7978845608 * (x + 0.044715 * x * x * x)))

# SiLU, also called swish. x * sigmoid(x): smooth, unbounded above, and the
# activation most modern vision and language models reach for over relu.
fn silu(x) = x * sigmoid(x)

# Mish. Smoother than silu at the cost of another exp and a tanh, and slightly
# better behaved where the input is strongly negative.
fn mish(x) = x * tanh(softplus(x))

# ELU. Negative inputs decay to -alpha rather than to zero, so a unit that has
# gone negative still has a gradient and can come back — the dead-relu problem
# leaky_relu attacks from the other direction.
fn elu(x, alpha) = where(greater(x, 0.0), x, alpha * (exp(x) - 1.0))

# Relu clipped at 6. The ceiling is what keeps activations in a range a
# low-precision format can represent, which is why mobile architectures use it.
fn relu6(x) = clip(relu(x), 0.0, 6.0)

# Softsign: x / (1 + |x|). Saturates polynomially rather than exponentially, so
# it approaches its limits far more slowly than tanh.
fn softsign(x) = x / (1.0 + abs(x))

# Log of the softmax, computed through logsumexp rather than as log(softmax(x)).
#
# That is the whole point of it existing. Taking the log of a softmax means
# exponentiating first, and a logit around -800 underflows to exactly zero,
# whose log is -inf and whose gradient is NaN. Subtracting logsumexp never
# forms the small number in the first place.
fn log_softmax(x, axis) = x - logsumexp(x, axis)

# ---- initializers --------------------------------------------------------
# He/Kaiming and Xavier/Glorot scaling for a (nout x nin) weight matrix.

fn he_init(nout, nin) = randn(nout, nin) * sqrt(2.0 / nin)

fn xavier_init(nout, nin) = randn(nout, nin) * sqrt(1.0 / nin)

# A [vocab, dim] embedding table with small random init.
fn embedding_init(vocab, dim) = randn(vocab, dim) * 0.1

# He-initialized convolution layer: kernel [Cout, Cin, KH, KW] with fan-in
# Cin*KH*KW, and a zero bias [Cout, 1, 1]. Returns the [kernel, bias] pair the
# `conv` layer expects.
fn conv_init(cout, cin, kh, kw) =
  [randn(cout, cin, kh, kw) * sqrt(2.0 / (cin * kh * kw)), zeros(cout, 1, 1)]

# ---- losses --------------------------------------------------------------

fn mse(pred, target) = mean(square(pred - target))

fn bce(pred, target) {
  let eps = 0.0000001
  let terms = target * log(pred + eps) + (1.0 - target) * log(1.0 - pred + eps)
  0.0 - mean(terms)
}

# One-hot vector of length n with a 1 at index i.
fn onehot(i, n) = equal(tensor(range(n)), i)

# Softmax cross-entropy from raw logits (a length-C vector) and a one-hot
# target. Uses logsumexp for numerical stability.
fn cross_entropy(logits, target) = logsumexp(logits, 0) - sum(logits * target)

# Mean absolute error. Unlike mse the penalty grows linearly, so a single wild
# label pulls the fit far less than it would under a squared error.
fn mae(pred, target) = mean(abs(pred - target))

# Huber loss: squared within delta of the target, linear outside it.
#
# The point is to be mse where the model is nearly right and mae where it is
# not, so outliers stop dominating the gradient without giving up the smooth
# curvature near the optimum that makes the easy part converge quickly.
fn huber(pred, target, delta) {
  let e = abs(pred - target)
  mean(where(less_equal(e, delta), 0.5 * square(e), delta * (e - 0.5 * delta)))
}

# Binary cross-entropy straight from logits, without forming the probability.
#
# `bce` above takes probabilities, which means something has already called
# sigmoid, and for a logit of -50 that returns exactly 0 — whose log is -inf.
# The epsilon in `bce` hides the infinity and leaves the gradient wrong. This
# form never creates the small number: written as
# max(x,0) - x*target + log(1 + exp(-|x|)), every term is finite for any input.
fn bce_with_logits(logits, target) {
  let stable = relu(logits) - logits * target + log(1.0 + exp(0.0 - abs(logits)))
  mean(stable)
}

# Hinge loss for a target in {-1, +1}. Zero once the example is on the right
# side of the margin, so correct and confident predictions stop contributing
# gradient at all — which is what makes it a margin loss rather than a
# probability one.
fn hinge(pred, target) = mean(relu(1.0 - target * pred))

# KL divergence from q to p, both probability vectors. Not symmetric: it
# measures the cost of using q to describe data that is really p.
fn kl_div(p, q) {
  let eps = 0.0000001
  sum(p * (log(p + eps) - log(q + eps)))
}

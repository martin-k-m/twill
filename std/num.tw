# num.tw — the numerics the built-ins leave out.
#
# `sum`, `mean`, `max`, `min` and `argmax` are interpreter built-ins because
# they need a gradient rule each. Everything here is composed from those, which
# is the point: a function written in Twill out of differentiable pieces is
# differentiable, so `grad(std)` works without anyone writing a backward pass
# for it.
#
# Every reduction takes an optional axis and follows the built-ins' convention:
# one argument reduces the whole tensor to a scalar, two reduce along an axis.

import "std/shapes" as sh

# Re-exported so `num.numel(x)` works without a second import for the one thing
# every count-based statistic here needs.
fn numel(x) = sh.numel(x)
fn rank(x) = sh.rank(x)

# ── Spread ──────────────────────────────────────────────────────────────────

# Population variance: the mean squared deviation from the mean.
#
# Population rather than sample, matching the built-in `mean` it is built on and
# what a loss function wants.
fn var(x) {
  let mu = mean(x)
  mean(square(x - mu))
}

# Variance along an axis.
#
# The mean has to be put back before it can be subtracted, and that is not
# optional bookkeeping. A reduction drops the axis it reduced, so `mean(x, 1)`
# of a [2, 3] is a [2] — and broadcasting aligns from the right, so [2] against
# [2, 3] is a shape error rather than the per-row mean anyone intended. Only a
# reduction over axis 0 happens to line back up by accident.
#
# `keep` restores the axis at length 1 and expands it back to the original
# shape, which is what other array libraries spell as `keepdims=True`.
fn var_axis(x, axis) {
  let mu = keep(mean(x, axis), x, axis)
  mean(square(x - mu), axis)
}

# A reduction result re-expanded to the shape it was reduced from.
fn keep(r, x, axis) = broadcast_to(sh.unsqueeze(r, axis), shape(x))

# ── Sample statistics ───────────────────────────────────────────────────────

# Sample variance, dividing by n - 1 rather than n.
#
# The population versions above divide by n, which is right when the tensor is
# the whole population and is what a loss function wants. When it is a sample
# and the variance is an estimate of something wider, dividing by n understates
# it, because the mean being subtracted was measured from the same sample and
# therefore sits closer to it than the true mean does. Bessel's correction is
# the n / (n - 1) rescale that removes that bias, and it is why numpy's `var`
# has a `ddof` argument and why the two answers differ on small samples.
#
# A single element has no spread to estimate; the correction would divide by
# zero, so it is left alone.
fn var_s(x) {
  let n = numel(x)
  if n < 2 { var(x) } else { var(x) * n / (n - 1) }
}

fn var_s_axis(x, axis) {
  let n = shape(x)[sh.axis_of(axis, rank(x), 0)]
  if n < 2 { var_axis(x, axis) } else { var_axis(x, axis) * n / (n - 1) }
}

fn std_s(x) = sqrt(var_s(x) + 0.00000001)

fn std_s_axis(x, axis) = sqrt(var_s_axis(x, axis) + 0.00000001)

# Sample covariance and correlation, same correction. Correlation is unchanged
# by it in exact arithmetic — the factor appears once on top and once under the
# root below — but it is here so a set of sample statistics is not missing one.
fn cov_s(a, b) {
  let n = numel(a)
  if n < 2 { cov(a, b) } else { cov(a, b) * n / (n - 1) }
}

fn corr_s(a, b) = cov_s(a, b) / (std_s(a) * std_s(b))

# Standard deviation: the square root of the variance, so in the same units as
# the data.
#
# The epsilon is not decoration. `sqrt` has an infinite derivative at zero, so a
# constant tensor — variance exactly zero — makes `grad(std)` return NaN rather
# than the zero it should. Adding a tiny floor before the root keeps the
# gradient finite, which is why every standardization in data.tw does the same.
fn std(x) = sqrt(var(x) + 0.00000001)

fn std_axis(x, axis) = sqrt(var_axis(x, axis) + 0.00000001)

# ── Position ────────────────────────────────────────────────────────────────

# Index of the smallest element along an axis.
#
# `argmax` of the negation: the largest element of -x is the smallest of x, and
# it saves a second implementation that could disagree with the first about
# ties.
fn argmin(x) = argmax(-x)

fn argmin_axis(x, axis) = argmax(-x, axis)

# ── Magnitude ───────────────────────────────────────────────────────────────

# Euclidean (L2) norm. The same epsilon reasoning as `std`: the derivative of
# `sqrt` at zero is infinite, and a zero vector is exactly what a freshly
# initialized parameter looks like.
fn norm(x) = sqrt(sum(square(x)) + 0.00000001)

fn norm_axis(x, axis) = sqrt(sum(square(x), axis) + 0.00000001)

# Manhattan (L1) norm — the sum of magnitudes. No epsilon needed: `abs` is not
# differentiable at zero either, but it is bounded there rather than infinite.
fn norm1(x) = sum(abs(x))

# Root mean square.
fn rms(x) = sqrt(mean(square(x)) + 0.00000001)

# ── Rescaling ───────────────────────────────────────────────────────────────

# Z-score the whole tensor to mean 0 and unit variance.
#
# data.tw has `standardize` for the per-column case, which is what a feature
# matrix wants. This is the whole-tensor version, for a single signal.
fn zscore(x) = (x - mean(x)) / std(x)

# Rescale to [0, 1]. Flat input would divide by zero, so the range is floored;
# a constant tensor comes out as zeros rather than NaN.
fn minmax(x) {
  let lo = min(x)
  (x - lo) / (max(x) - lo + 0.00000001)
}

# ── Two-sample statistics ───────────────────────────────────────────────────

# Mean squared error, the same quantity `nn.tw` uses as a loss, exposed here as
# a plain statistic.
fn mse(a, b) = mean(square(a - b))

# Mean absolute error. Less sensitive to outliers than `mse`, because the error
# is not squared before averaging.
fn mae(a, b) = mean(abs(a - b))

# Population covariance between two tensors of the same shape.
fn cov(a, b) = mean((a - mean(a)) * (b - mean(b)))

# Pearson correlation, in [-1, 1]. Covariance divided by both standard
# deviations, which is what makes it scale-free: correlation does not change
# when either input is multiplied by a constant.
fn corr(a, b) = cov(a, b) / (std(a) * std(b))

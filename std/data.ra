# data.ra — dataset utilities for real training loops.
#
# These build on `gather` (differentiable row selection) and `permutation`
# (a seeded shuffle), so shuffling and minibatching a dataset is a couple of
# array operations, and stays reproducible.

# Z-score each column of a [rows, cols] matrix to mean 0, variance 1. Returns
# [standardized, mean, std] so the same transform can be reused at inference.
fn standardize(X) {
  let mu = mean(X, 0)
  let sd = sqrt(mean(square(X - mu), 0)) + 0.00000001
  [(X - mu) / sd, mu, sd]
}

# Apply a stored (mean, std) standardization to new data.
fn apply_standardize(X, mu, sd) = (X - mu) / sd

# Split rows into train and test by a fraction (e.g. 0.8 keeps 80% for
# training). Deterministic given the seed; returns [Xtr, ytr, Xte, yte].
fn train_test_split(X, y, frac) {
  let n = len(X)
  let cut = int(frac * n)
  let idx = permutation(n)
  let tr = idx[0:cut]
  let te = idx[cut:n]
  [gather(X, tr), gather(y, tr), gather(X, te), gather(y, te)]
}

# A freshly shuffled copy of a dataset (features and labels kept aligned).
fn shuffle(X, y) {
  let p = permutation(len(X))
  [gather(X, p), gather(y, p)]
}

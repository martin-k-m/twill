# nn.ast — a small neural-network toolkit, written in Aster.
#
# Import it with:  import "std/nn.ast"  (adjust the path to your file).
# Parameters are held in plain lists, so `grads` differentiates a whole model
# at once and `sgd_step` updates it with map/zip.

# ---- layers --------------------------------------------------------------

# Affine layer: y = W @ x + b.
fn dense(W, b, x) = W @ x + b

# ---- activations ---------------------------------------------------------
# relu, tanh, sigmoid are builtins; here are a couple more.

fn softplus(x) = log(1.0 + exp(x))

fn leaky_relu(x) = relu(x) - 0.01 * relu(-x)

# Numerically-stable-ish softmax over a 1-D vector.
fn softmax(x) {
  let e = exp(x - max_val(x))
  e / sum(e)
}

fn max_val(x) {
  let m = x[0]
  for xi in x {
    if xi > m { m = xi }
  }
  m
}

# ---- losses --------------------------------------------------------------

fn mse(pred, target) = mean((pred - target) * (pred - target))

fn bce(pred, target) {
  let eps = 0.0000001
  let a = target * log(pred + eps)
  let b = (1.0 - target) * log(1.0 - pred + eps)
  -mean(a + b)
}

# ---- optimizer -----------------------------------------------------------

# One SGD step over a list of params and their matching gradients.
fn sgd_step(params, grads, lr) =
  map(fn(pg) = pg[0] - pg[1] * lr, zip(params, grads))

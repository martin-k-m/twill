{
  "Function": {
    "prefix": "fn",
    "body": ["fn ${1:name}(${2:args}) {", "\t$0", "}"],
    "description": "Function definition"
  },
  "Function (expression body)": {
    "prefix": "fn=",
    "body": ["fn ${1:name}(${2:args}) = $0"],
    "description": "Function with an expression body"
  },
  "Let binding": {
    "prefix": "let",
    "body": ["let ${1:name} = $0"],
    "description": "Let binding"
  },
  "For loop": {
    "prefix": "for",
    "body": ["for ${1:i} in ${2:range(0, ${3:n})} {", "\t$0", "}"],
    "description": "For-in loop"
  },
  "While loop": {
    "prefix": "while",
    "body": ["while ${1:cond} {", "\t$0", "}"],
    "description": "While loop"
  },
  "If": {
    "prefix": "if",
    "body": ["if ${1:cond} {", "\t$0", "}"],
    "description": "If block"
  },
  "If / else": {
    "prefix": "ifelse",
    "body": ["if ${1:cond} {", "\t$2", "} else {", "\t$0", "}"],
    "description": "If / else block"
  },
  "Match": {
    "prefix": "match",
    "body": ["match ${1:subject} {", "\t${2:Pattern} => $3,", "\t_ => $0,", "}"],
    "description": "Match expression"
  },
  "Enum": {
    "prefix": "enum",
    "body": ["enum ${1:Name} {", "\t${2:Case},", "\t${3:Case}(${4:Payload}),", "}"],
    "description": "Enum declaration"
  },
  "Struct": {
    "prefix": "struct",
    "body": ["struct ${1:Name} {", "\t${2:field}: ${3:Type},", "}"],
    "description": "Struct declaration"
  },
  "Import": {
    "prefix": "import",
    "body": ["import \"${1:module}\" as ${2:alias}"],
    "description": "Namespaced import"
  },
  "Mode systems": {
    "prefix": "mode",
    "body": ["mode systems"],
    "description": "Systems-mode declaration"
  },
  "grad": {
    "prefix": "grad",
    "body": ["grad(${1:f})(${2:x})"],
    "description": "Gradient of f at x"
  }
}

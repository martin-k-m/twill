{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Twill",
  "scopeName": "source.twill",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#autodiff" },
    { "include": "#builtins" },
    { "include": "#numbers" },
    { "include": "#function-def" },
    { "include": "#function-call" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.twill",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.twill",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.twill",
          "match": "\\\\."
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.twill",
          "match": "\\b(if|else|while|for|in|return|import)\\b"
        },
        {
          "name": "storage.type.twill",
          "match": "\\b(let|fn)\\b"
        },
        {
          "name": "keyword.operator.logical.twill",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "constants": {
      "name": "constant.language.twill",
      "match": "\\b(true|false)\\b"
    },
    "autodiff": {
      "name": "support.function.autodiff.twill",
      "match": "\\b(grad|grads|value_and_grad)\\b"
    },
    "builtins": {
      "name": "support.function.builtin.twill",
      "match": "\\b(print|relu|sigmoid|tanh|exp|log|sin|cos|sqrt|square|abs|pow|clip|sum|mean|max|min|argmax|softmax|logsumexp|maximum|minimum|where|greater|less|greater_equal|less_equal|equal|matmul|dot|einsum|transpose|reshape|concat|tensor|scalar|zeros|ones|fill|randn|rand|eye|shape|len|item|range|list|str|map|zip|fold|append|enumerate)\\b"
    },
    "numbers": {
      "name": "constant.numeric.twill",
      "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
    },
    "function-def": {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.twill" },
        "2": { "name": "entity.name.function.twill" }
      }
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.twill" }
      }
    },
    "operators": {
      "name": "keyword.operator.twill",
      "match": "(@|\\+|-|\\*|/|%|\\^|==|!=|<=|>=|<|>|=|->)"
    }
  }
}

{
  "name": "twill-lang",
  "displayName": "Twill",
  "description": "Syntax highlighting and snippets for the Twill tensor-first differentiable language (.tw).",
  "version": "1.0.0",
  "publisher": "twill-lang",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#12332C",
    "theme": "dark"
  },
  "keywords": [
    "twill",
    "tensor",
    "autodiff",
    "differentiable",
    "machine learning"
  ],
  "homepage": "https://github.com/martin-k-m/twill",
  "repository": {
    "type": "git",
    "url": "https://github.com/martin-k-m/twill.git"
  },
  "bugs": {
    "url": "https://github.com/martin-k-m/twill/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "twill",
        "aliases": ["Twill", "twill"],
        "extensions": [".tw"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "twill",
        "scopeName": "source.twill",
        "path": "./syntaxes/twill.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "twill",
        "path": "./snippets/twill.json"
      }
    ]
  }
}

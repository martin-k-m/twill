{
  "name": "twill-lang",
  "displayName": "Twill",
  "description": "Syntax highlighting for the Twill tensor language (.tw).",
  "version": "0.1.0",
  "publisher": "twill-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/martin-k-m/raster.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "twill",
        "aliases": ["Twill", "twill"],
        "extensions": [".tw"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "twill",
        "scopeName": "source.twill",
        "path": "./syntaxes/twill.tmLanguage.json"
      }
    ]
  }
}

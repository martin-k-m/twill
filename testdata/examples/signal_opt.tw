# signal_opt.tw: tune a trading signal by gradient ascent on its Sharpe ratio.
#
# The backtest Sharpe is differentiable in the return series, and the strategy's
# returns are a smooth function of the signal's weights, so `grad` hands back
# the gradient of Sharpe with respect to those weights, and we simply climb it.
# No Python, no JAX: this is reverse-mode autodiff straight through a backtest,
# which is exactly what a vanilla Python backtest can't give you.

import "std/backtest" as bt

seed(3)

# A synthetic market: d predictive features per day, and a next-day asset return
# that genuinely depends on them (so a good signal is learnable), plus noise.
let n = 600
let d = 3
let F = randn(n, d)                                  # features known before the day
let truth = [0.8, -0.5, 0.3]
let asset = F @ truth * 0.01 + 0.03 * randn(n)       # realized next-day return (noisy)

# A parametric signal: position each day is tanh(features . theta), in [-1, 1].
# `theta` is what we learn. Features are known before the return realizes, so
# multiplying by the same day's return introduces no look-ahead.
fn positions(theta) = tanh(F @ theta)
fn strat_returns(theta) = positions(theta) * asset

# Objective to maximize: the annualized Sharpe ratio of the strategy.
fn objective(theta) = bt.sharpe(strat_returns(theta), 252.0)

# Gradient ascent. Start from a small random guess (all-zeros would make the
# Sharpe 0/0), then step in the direction grad points.
let theta = 0.1 * randn(d)
let lr = 0.04
for step in range(500) {
  let g = grad(objective)(theta)
  theta = theta + lr * g
  if step % 100 == 0 {
    print("step", step, "Sharpe", objective(theta))
  }
}

print("learned weights:", theta, "(true signal:", truth, ")")
print("final strategy Sharpe:", objective(theta))
print("final strategy Sortino:", bt.sortino(strat_returns(theta), 252.0))
print("buy-and-hold Sharpe:", bt.sharpe(asset, 252.0))

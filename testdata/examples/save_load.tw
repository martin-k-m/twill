# save_load.tw — train a model, save it, load it back: the deploy story.
#
# A trained model in Twill is just data — a record or list of tensors, or a
# native model like a gradient-boosted forest. `save` writes any value to a
# file (exactly, bit-for-bit); `load` reads it back. So you can train once and
# ship the model alongside the single static binary for inference anywhere.

seed(5)

# Train a gradient-boosted classifier on a synthetic table.
let n = 400
let X = randn(n, 4)
let w = [1.0, -2.0, 0.5, 0.0]
let y = greater(X @ w, 0.0)
let model = gbm_fit(X, y, { objective: "logistic", rounds: 60, max_depth: 3 })

save(model, "model.bin")
print("trained and saved:", model)

# ...later, in a fresh process, you'd just load and use it:
let restored = load("model.bin")
let a = greater(gbm_predict(model, X), 0.5)
let b = greater(gbm_predict(restored, X), 0.5)
print("agreement after reload:", mean(equal(a, b)))   # 1.0 == identical

# A neural network's parameters (a record of tensors) round-trip just the same.
let params = { w1: randn(8, 4), b1: zeros(8), w2: randn(1, 8), b2: zeros(1) }
save(params, "params.bin")
let back = load("params.bin")
print("weights preserved exactly:", mean(equal(params.w1, back.w1)))

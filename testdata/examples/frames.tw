# frames.tw: tabular / time-series data with frames.
#
# A frame is just a record whose fields are named column tensors, so field
# access, slicing, and grad all work on it. `read_frame` loads a CSV with a
# header row; `columns`/`field`/`with_field` manipulate columns by name.

let df = read_frame("prices.csv")
print("columns:", columns(df))
print("rows:", len(df.close))

# Daily log returns: r_t = log(close_t / close_{t-1}).
let c = df.close
let n = len(c)
let ret = log(c[1:n] / c[0:n - 1])

let avg = mean(ret)
let vol = sqrt(mean(square(ret - avg)))

print("mean daily return:", avg)
print("daily volatility:", vol)
print("annualized volatility:", vol * sqrt(252.0))

# Add the returns as a new column (one shorter, so pad the first day with 0).
let padded = concat([[0.0], ret], 0)
let df2 = with_field(df, "ret", padded)
print("columns after with_field:", columns(df2))

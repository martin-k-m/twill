mode systems

# builtins.tw: the one list of builtin names, shared by the checker and the
# evaluator.
#
# NEEDS-52 was the drift risk of keeping this list twice. src/check.tw held it
# for the unknown-name diagnostic, and src/eval.tw wanted the same set to turn a
# bare name into a VBuiltin, and the comment there said "is_builtin is the
# check.tw table again" over a call to a function that did not exist. This file
# is the shared table both of them meant: check.tw builds its set from NAMES and
# eval.tw asks is_builtin_name, so a builtin added to the dispatch is a name
# added here once and seen by both, and the two can no longer disagree.
#
# The list is the evaluator's dispatch set and the checker's known-name set,
# which are the same set by intent. A name here that eval does not dispatch
# would check clean and fail at run time; a name eval dispatches that is missing
# here would be reported as unknown though it works. Keeping one list is what
# makes both of those impossible rather than merely unlikely.

import "bytes.tw" as bytes

let NAMES: Str = "print relu exp log sin cos tanh sigmoid sqrt sum prod median mean abs pow matmul dot grad grads value_and_grad map zip tensor scalar zeros ones fill randn rand eye transpose shape len item dtype range list str square maximum minimum greater less greater_equal less_equal equal where clip max min argmax argmin flip roll diff softmax logsumexp sort topk reshape broadcast_to concat fold append enumerate read_csv einsum map_leaves zip_leaves seed read_frame write_frame columns field with_field gbm_fit gbm_predict cumsum cumprod cummax cummin conv2d maxpool2d save load gather permutation int floor ceil round jacobian hessian and or xor shl shr bnot Ok Err Some None unit f64_sqrt f64_exp f64_log f64_sin f64_cos f64_floor f64_trunc f64_pow f64_of_i64 i64_of_f64 f64_bits f64_from_bits f64_signbit arr_new push pop dict_new dict_set dict_get dict_has dict_must dict_or dict_keys bytes_new bytes_push bytes_to_str abort dict_del buf_new buf_get8 buf_set8 buf_len argsort f64_ceil f64_round f64_tanh f64_mod i64 f64 write_out write_err read_file write_file list_dir resolve_path str_quote i64_of_str emit_line rng_seed rng_uniform rng_normal rng_perm is_same args save_value load_value arr arr_clear chr slice gpu_available gpu_device_count is_tty_stdout window_size gpu_device_open gpu_device_info gpu_device_close gpu_alloc gpu_free gpu_write gpu_read gpu_copy gpu_program_build gpu_kernel gpu_set_arg_buffer gpu_set_arg_local gpu_launch gpu_finish gpu_device_info_i64 gpu_set_arg_i64 gpu_set_arg_f64 env clock_now_ms str_to_f64 f64_to_str num_to_text"

# Membership over the space-separated list. Padding both sides is what stops
# "max" from matching inside "cummax": the same trick eval's in_words and
# check's in_set use, so the needle can only land on a whole word.
fn is_builtin_name(name: Str) -> Bool {
  let hay: Str = bytes.concat(" ", bytes.concat(NAMES, " "))
  let needle: Str = bytes.concat(" ", bytes.concat(name, " "))
  bytes.index_of(hay, needle) >= 0
}
